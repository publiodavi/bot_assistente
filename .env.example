# Chave de acesso à API DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sua_chave_aqui

# URL base da API (compatível com o SDK da OpenAI)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo de linguagem utilizado pelo assistente
DEEPSEEK_MODEL=deepseek-chat

# Contas e histórico. Preencha as quatro variáveis para habilitar o modo autenticado.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
CHAINLIT_AUTH_SECRET=
DATABASE_URL=
# URL do app para o OAuth. O callback local usa /auth/oauth/google/callback.
CHAINLIT_URL=http://localhost:8103

# A imagem Docker usa public: qualquer conta Google com e-mail verificado.
# Para convites, use invited e preencha a lista abaixo. Sem esta variável, o login fica restrito a convidados.
STUDY_ACCESS_MODE=public
STUDY_ALLOWED_EMAILS=

# Pasta do índice dos materiais (ChromaDB). No Railway, use o volume: /data/chroma
STUDY_CHROMA_DIR=.local/chroma

# Ambiente. Em production, o app recusa iniciar sem as variáveis obrigatórias ou em modo demonstração.
# STUDY_ENV=production

# Teto diário global de uso, somando todas as contas (padrões: 3000, 400 e 600).
# STUDY_GLOBAL_DAILY_CHAT=3000
# STUDY_GLOBAL_DAILY_CARDS=400
# STUDY_GLOBAL_DAILY_UPLOAD=600

# Apenas para os 7 testes de integração: PostgreSQL local (cria e remove um schema descartável).
# STUDY_TEST_DATABASE_URL=postgresql+asyncpg://usuario:senha@127.0.0.1:5432/ajudai
