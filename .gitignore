# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Ambiente virtual
venv/
.venv/
env/

# Variáveis de ambiente (segredos)
.env
.local/

# Chainlit
# A pasta .chainlit e o arquivo .chainlit/config.toml são versionados para
# preservar o tema e as configurações de interface do assistente.
# Apenas artefatos de cache e uploads locais são ignorados abaixo.
.chainlit/cache/
.chainlit/.cache/
.chainlit/.files/
.files/

# Banco vetorial local (RAG)
chroma_db/
chroma/

# Logs e cópias locais
*.log
.chainlit/config.original.toml

# Traduções geradas pelo Chainlit; preservar a revisão brasileira
.chainlit/translations/*
!.chainlit/translations/pt-BR.json

# Variações de arquivos de ambiente
.env.*
!.env.example
