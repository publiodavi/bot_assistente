erDiagram
  users ||--o{ threads : "possui"
  users ||--o| study_profiles : "tem"
  users ||--o{ study_materials : "envia"
  users ||--o{ study_usage : "consome"
  threads ||--o{ steps : "contém"
  threads ||--o{ elements : "contém"
  threads ||--o{ feedbacks : "recebe"
  threads ||--o| study_card_decks : "gera"
  threads ||--o| study_trail_progress : "legado"
  users { uuid id PK
    text identifier UK
    jsonb metadata }
  threads { uuid id PK
    uuid userId FK
    text name
    jsonb metadata "modo Guia/Aprende" }
  steps { uuid id PK
    uuid threadId FK
    text type
    text output
    jsonb metadata "companheiro, Escada, interrompida" }
  elements { uuid id PK
    uuid threadId FK
    text type }
  feedbacks { uuid id PK
    uuid threadId FK
    int value }
  study_profiles { uuid user_id PK
    jsonb data "preferências, apelidos, Fichário" }
  study_card_decks { uuid thread_id PK
    uuid user_id FK
    jsonb data "cartões e caixas" }
  study_materials { uuid id PK
    uuid user_id FK
    text name
    int pages
    text status }
  study_usage { uuid id PK
    uuid user_id FK
    text operation
    timestamptz expires_at }
  study_trail_progress { uuid thread_id PK
    int stage }
